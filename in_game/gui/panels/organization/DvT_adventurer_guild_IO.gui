# DvT 冒险家协会面板 —— 使用 NCIOframe 的共享 theme（P7 GUI 复用试验，DvT 先行）
#
# 本文件只保留 DvT 的"叶子素材"：
#   - 顶部徽记（含 tooltip）——theme 暂不抽象，保留整块；
#   - 货币栏内容（ncio_currency 槽）——数值/图标/tooltip；
#   - 底部提示卡文案（ncio_hint_title / ncio_hint_desc 槽）。
# 其余（tab 可见性、变量栏可见性、动作列表、货币栏骨架、提示卡骨架）全在 NCIOframe 的 ncio_io_theme。
# 动作按钮不再手写：由 generic_actions 的 show_in_gui_list（默认列出）+ icon + visible 过滤自动生成。
#
# 回滚：git -C DiscoverTeyvat checkout -- in_game/gui/panels/organization/DvT_adventurer_guild_IO.gui

ncio_io_theme = {
	# 顶部标志和背景
	blockoverride "organization_panel_extra_item" {
		allow_outside = yes
		flowcontainer = {
			parentanchor = top|hcenter
			icon = {
				parentanchor = top
				texture = "gfx/interface/icons/international_organizations/DvT_adventurer_guild_IO_coa.dds"
				texture_density = 2
				size = { 100 100 }
			}
			position = {0 -50}
		}
		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon" {
					icon = {
						texture = "gfx/interface/icons/international_organizations/DvT_adventurer_guild_IO.dds"
						size = { 42 42 }
					}
				}
				blockoverride "title_text" {
					text = "DvT_adventurer_guild_IO"
				}
				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						blockoverride "text" {
							text = "DvT_adventurer_guild_IO_desc"
						}
					}
					TooltipTextBlock = {
						blockoverride "text" {
							text = "AG_desc"
						}
					}
				}
			}
		}
	}

	# 变量栏内容（原石）
	blockoverride "ncio_currency" {
		text_single = {
			autoresize = yes
			align = right
			raw_text = "[GetPlayer.MakeScope.GetVariable('AG_Primogem').GetValue]"
		}
		widget = {
			size = { 24 24 }
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/international_organizations/DvT_primogem.dds"
			}
		}
		tooltipwidget = {
			ContextualTooltipType = {
				blockoverride "title_icon" {
					icon = {
						texture = "gfx/interface/icons/international_organizations/DvT_primogem.dds"
						size = { 42 42 }
					}
				}
				blockoverride "title_text" {
					text = "AG_Primogem"
				}
				blockoverride "tooltip_content" {
					TooltipTextBlock = {
						blockoverride "text" {
							text = "AG_Primogem_desc"
						}
					}
					TooltipTextBlock = {
						blockoverride "block_title" {
							text = "AG_Primogem_Change"
						}
						blockoverride "text" {
							text = "AG_Primogem_Change_Value"
						}
					}
				}
			}
		}
	}

	# 底部提示卡文案
	blockoverride "ncio_hint_title" {
		margin = { 10 0 }
		raw_text = "DvT_adventurer_guild_IO_hint_title"
	}
	blockoverride "ncio_hint_desc" {
		margin = { 20 10 }
		text = "DvT_adventurer_guild_IO_hint_desc"
		multiline = yes
		autoresize = yes
		layoutpolicy_horizontal = expanding
	}
}
